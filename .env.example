# Modelo LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo LLM (lo lee config/settings.py)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.5-flash-lite
# Pon tu clave en tu .env, nunca aquí. Se crea gratis en Google AI Studio (aistudio.google.com)
LLM_API_KEY=

# APIs de datos locales
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

# Configuración general
MAX_REVISIONES=3
MAX_TOKENS_POR_INFORME=50000
DEMO_MODE=true # or false to deactivate demo mode
