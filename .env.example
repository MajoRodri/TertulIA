# LLM — provider + model name follow CrewAI's "provider/model" format
# Pon tu clave en tu .env, nunca aquí. Se crea gratis en Google AI Studio (aistudio.google.com)
LLM_PROVIDER=gemini
# Verify this model name exists in your Google AI Studio account before deploying.
# Google's public naming convention is gemini-2.0-flash-lite or gemini-2.5-flash-lite.
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_API_KEY=

# CORS — pon la URL de tu app en Railway (sin barra final)
# En local puedes dejarlo vacío o usar: http://localhost:8000
ALLOWED_ORIGINS=https://tu-app.up.railway.app

# APIs de datos locales
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=

# Graph controls
MAX_ITERATIONS=3
MAX_TOKENS_PER_REPORT=500000
# HITL timeout: seconds before a paused study expires (default 24 h)
HUMAN_TIMEOUT_S=86400

# Rate limiting — max requests per IP per minute
RATE_LIMIT_ANALYZE=5
RATE_LIMIT_UPLOAD=10

# Confidence penalties (used by schemas.compute_confidence)
MISSING_PENALTY=0.1
SUSPICIOUS_PENALTY=0.05
